# Server konfiguratsiyasi
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Ma'lumotlar bazasi: memory (lokal/test) yoki firestore (ishlab chiqarish)
STORE=memory

# Telegram Login Widget autentifikatsiyasi (Telegram Bot / Mini App emas, faqat Web Login)
# BotFather orqali /setdomain buyrug'i bilan sayt domenini ulang
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN
TELEGRAM_BOT_USERNAME=huquqpro_bot

# Sessiya cookie imzolash kaliti (kamida 32 belgi)
SESSION_SECRET=change-this-to-a-long-random-secret-key-in-production-32chars

# Rollar (vergul bilan ajratilgan Telegram foydalanuvchi ID raqamlari)
ADMIN_TELEGRAM_IDS=100001
TEACHER_TELEGRAM_IDS=100002

# Google Gemini AI (faqat backendda ishlatiladi, hech qachon frontendga chiqmaydi)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_LIVE_MODEL=gemini-3.8-live

# AI Ustoz kunlik kvota va davomiylik cheklovlari
AI_TUTOR_MAX_SESSIONS_PER_DAY=5
AI_TUTOR_MAX_DURATION_SEC=600

# Firebase Firestore (faqat STORE=firestore bo'lganda kerak)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Lokal ishlab chiqish uchun ixtiyoriy dev bypass (faqat NODE_ENV !== 'production' va 127.0.0.1)
DEV_AUTH_USER_ID=
DEV_AUTH_ROLE=student
